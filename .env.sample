# Copy to .env and fill in. Never commit .env.

# Mapillary v4 access token (free, non-commercial):
# https://www.mapillary.com/dashboard/developers
MAPILLARY_TOKEN=

# Which brain implementation the oracle serves: real | mock
# (real requires the prepared MaleCNS dataset in /data and g++ for the kernel)
FLY_BRAIN=real

# Oracle URL the walker talks to (compose service name inside the VM network)
ORACLE_URL=http://oracle:8000

# Route: corridor bounding box (south,west,north,east, WGS84 decimal degrees),
# start point (lat,lng) and goal point (lat,lng). Pick after checking
# Mapillary coverage. Defaults are the route v2 (coverage-verified 2026-09-15):
# Rossio -> Rua de Santa Justa / Largo do Carmo neighbourhood, 369m crow-flies.
ROUTE_BBOX=38.7115,-9.1445,38.7190,-9.1365
ROUTE_START=38.7139,-9.1394
ROUTE_GOAL=38.71685,-9.14135

# Goal-bias veil (v2): how strongly candidate frames brighten with proximity
# to the goal. K = per-junction delta gain, L = delta length scale (m),
# ABS = absolute ramp toward the nata. Tune K first if the fly drifts sideways.
GOAL_SALIENCE_K=1.7
GOAL_SALIENCE_L=25.0
GOAL_SALIENCE_ABS=0.3

# Walker pacing / episode limits
ARRIVAL_RADIUS_M=25
MAX_STEPS=400
THINK_MS=500

# Where run artifacts live inside containers (shared volume)
DATA_DIR=/data
